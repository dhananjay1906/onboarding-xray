rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared explanation cache. Signed-in (anonymous) users can read one entry and add new ones.
    // Entries are never changed or deleted from a client, and cannot be listed.
    match /explanations/{key} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && key.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['text', 'source', 'reason', 'promptVersion', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'source', 'promptVersion', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.source in ['on_device', 'cloud']
        && request.resource.data.promptVersion is string
        && request.resource.data.promptVersion.size() <= 32
        && (request.resource.data.reason == null
            || (request.resource.data.reason is string && request.resource.data.reason.size() <= 60))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
