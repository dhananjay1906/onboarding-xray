VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# App Check debug mode is always on in the extension (reCAPTCHA cannot run under Manifest V3).
# Optional: use one fixed debug token instead of a generated one. It is baked into the built extension,
# so never ship a zip or dist/ built with it. Never commit the token.
# VITE_APPCHECK_DEBUG_TOKEN=

# Submission build (npm run package:submission): the judges App Check debug token, injected at build time.
# Create a separate token for judges (see extension/README.md) and never commit it. Not read by dev builds.
# XRAY_APPCHECK_DEBUG_TOKEN=
