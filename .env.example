VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug mode (extension). Debug mode is on automatically for `npm run dev` / `npm run build:dev`.
# Optional: force it on in any build.
# VITE_APPCHECK_DEBUG=true
# Optional: use one fixed debug token instead of a generated one. It is baked into the built extension,
# so never ship a zip or dist/ built with it. Never commit the token.
# VITE_APPCHECK_DEBUG_TOKEN=
